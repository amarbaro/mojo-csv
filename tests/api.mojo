from csv import *
from test_golden import unhex, encode_rows, hex_bytes, hex_span
from std.testing import assert_equal


def main() raises:
    var tab = Dialect.excel_tab()
    assert_equal(tab.delimiter, UInt8(9))
    var unix = Dialect.unix_dialect()
    assert_equal(unix.quoting, QUOTE_ALL)
    assert_equal(hex_bytes(unix.lineterminator), "0a")
    var data = unhex("612c22620d0a63220d0a642c650a")
    var reader = Reader(Dialect.excel(), Span(data))
    assert_equal(reader.next(), True)
    var row = reader.row()
    assert_equal(Int(row[0].data.unsafe_ptr()), Int(data.unsafe_ptr()))
    assert_equal(hex_span(row[1].data), "620d0a63")
    var saved = row.to_list()
    var field_copy = row[1].to_list()
    var scratch_capacity = reader.scratch.capacity()
    var fields_capacity = reader.fields.capacity()
    assert_equal(reader.next(), True)
    assert_equal(hex_span(reader.row()[0].data), "64")
    assert_equal(hex_bytes(saved[1].data), "620d0a63")
    assert_equal(hex_bytes(field_copy), "620d0a63")
    assert_equal(reader.scratch.capacity(), scratch_capacity)
    assert_equal(reader.fields.capacity(), fields_capacity)
    assert_equal(reader.next(), False)
    assert_equal(reader.line_num, 3)
    var rows = reader.read_all()
    assert_equal(encode_rows(rows), "s61,s620d0a63/s64,s65")
    var output = write_all(rows, tab)
    assert_equal(hex_bytes(output), "610922620d0a63220d0a6409650d0a")
    var empty = OwnedField()
    var null = OwnedField(unhex("616263"), True)
    var own_row = List[OwnedField]()
    own_row.append(null^)
    own_row.append(empty^)
    var all_rows = List[List[OwnedField]]()
    all_rows.append(own_row^)
    assert_equal(hex_bytes(write_all(all_rows, Dialect.excel())), "2c0d0a")
    print("PASS api: input views, retained scratch, owning copies")
